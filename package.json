{
  "name": "hedefora",
  "version": "0.0.0",
  "private": true,
  "description": "HedefOra governed modular-monolith workspace",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm --filter @hedefora/web build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "ci:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm generated:check && pnpm todo:check && pnpm licenses:check && pnpm audit:prod",
    "contracts:lint": "node scripts/validate-contracts.mjs",
    "format:check": "prettier --check contracts scripts security/*.json package.json pnpm-workspace.yaml .spectral.yaml && pnpm --filter @hedefora/web format:check",
    "generated:check": "node scripts/generate-openapi.mjs --check && node scripts/check-generated.mjs",
    "generated:write": "node scripts/generate-openapi.mjs --write",
    "governance:check": "node scripts/validate-governance.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "lint": "pnpm contracts:lint && pnpm governance:check && pnpm --filter @hedefora/web lint",
    "supply-chain:check": "node scripts/supply-chain/run.mjs",
    "supply-chain:test": "node --test scripts/supply-chain/*.test.mjs",
    "test": "node --test scripts/*.test.mjs scripts/supply-chain/*.test.mjs && pnpm --filter @hedefora/web test:coverage",
    "todo:check": "node scripts/check-todos.mjs",
    "typecheck": "pnpm --filter @hedefora/web typecheck"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "prettier": "3.9.6"
  }
}
